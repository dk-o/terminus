{"id":"terminus","level":"INFO","at":"2026-05-27T21:56:18+00:00","message":"INSERT INTO \"extension\" (\"fields\", \"label\", \"interval\", \"kind\", \"data\", \"template\", \"name\", \"description\", \"unit\") VALUES ('[{\"keyname\":\"bio\",\"name\":\"About This Plugin\",\"field_type\":\"author_bio\",\"description\":\"Get a clear snapshot of today’s weather plus a 5-day forecast, including temperatures, uv indexes and rain chances.<br/><br/>This plugin was created by Daniel Sitnik, Principal Architect @ Accenture Brazil and creator of small things. Want a custom TRMNL Plugin for you? Check my <a href=\\\"https://ko-fi.com/danielsitnik/shop\\\" target=\\\"_blank\\\">ko-fi page</a> or e-mail me! 😀\",\"category\":\"life,personal\",\"learn_more_url\":\"https://ko-fi.com/danielsitnik/shop\",\"github_url\":\"http://github.com/danielsitnik/\",\"email_address\":\"danielsitnik@outlook.com\"},{\"keyname\":\"latitude\",\"field_type\":\"string\",\"name\":\"Latitude\",\"description\":\"The latitude of your location\",\"placeholder\":\"Latitude\",\"help_text\":\"Go to <a href=\\\"https://www.latlong.net\\\" target=\\\"_blank\\\">https://www.latlong.net</a>, search for the desired place or navigate using the map, then copy the latitude.\"},{\"keyname\":\"longitude\",\"field_type\":\"string\",\"name\":\"Longitude\",\"description\":\"The longitude of your location\",\"placeholder\":\"Longitude\",\"help_text\":\"Go to <a href=\\\"https://www.latlong.net\\\" target=\\\"_blank\\\">https://www.latlong.net</a>, search for the desired place or navigate using the map, then copy the longitude.\"},{\"keyname\":\"temp_unit\",\"field_type\":\"select\",\"name\":\"Temperature Unit\",\"description\":\"Select the desired temperature unit\",\"default\":\"fahrenheit\",\"options\":[{\"Celsius\":\"celsius\"},{\"Fahrenheit\":\"fahrenheit\"}]},{\"keyname\":\"location_name\",\"field_type\":\"string\",\"optional\":true,\"name\":\"Location Name\",\"placeholder\":\"Location name\",\"description\":\"Give a name to help identify this location (eg: home, office, city name, etc.)\",\"help_text\":\"This name will be displayed at the right side of the plugin title bar.\"}]'::jsonb, 'Daily Weather', 1, 'poll', '{\"values\":{\"temp_unit\":\"fahrenheit\"}}'::jsonb, '<style>\r\n  .screen--lg .view--full .weather-image {\r\n    width: 280px;\r\n  }\r\n  \r\n  .view--full .weather-image {\r\n    width: 180px;\r\n  }\r\n\r\n  .screen--lg .view--half_vertical .weather-image {\r\n    width: 260px;\r\n  }\r\n\r\n  .view--half_vertical .weather-image {\r\n    width: 160px;\r\n  }\r\n\r\n  .screen--lg .weather-icon {\r\n    width: 60px;\r\n  }\r\n  \r\n  .weather-icon {\r\n    width: 50px;\r\n  }\r\n\r\n  .screen--lg .weather-icon-mini {\r\n    width: 34px;\r\n  }\r\n\r\n  .weather-icon-mini {\r\n    width: 24px;\r\n  }\r\n\r\n  .screen--lg .weather-icon-forecast {\r\n    width: 100px;\r\n  }\r\n\r\n  .weather-icon-forecast {\r\n    width: 50px;\r\n  }\r\n</style>\r\n\r\n{%liquid\r\n  assign is_day = current.is_day\r\n  assign image_day = \"\"\r\n  \r\n  for i in (0..5)\r\n    if i == 0\r\n      assign code = current.weather_code\r\n    else\r\n      assign code = daily.weather_code[i]\r\n    endif\r\n\r\n    if code == 0 or code == 1\r\n      if is_day == 1\r\n        assign image_day = image_day | append: \"wi-day-sunny.svg,\"\r\n        assign condition = condition | append: \"Sunny,\"\r\n      else\r\n        assign image_day = image_day | append: \"wi-night-clear.svg,\"\r\n        assign condition = condition | append: \"Clear,\"\r\n      endif\r\n    elsif code == 2 or code == 3\r\n      assign condition = condition | append: \"Cloudy,\"\r\n      if is_day == 1\r\n        assign image_day = image_day | append: \"wi-day-cloudy.svg,\"\r\n      else\r\n        assign image_day = image_day | append: \"wi-night-cloudy.svg,\"\r\n      endif\r\n    elsif code == 45 or code == 48\r\n      assign condition = condition | append: \"Fog,\"\r\n      if is_day == 1\r\n        assign image_day = image_day | append: \"wi-day-fog.svg,\"\r\n      else\r\n        assign image_day = image_day | append: \"wi-night-fog.svg,\"\r\n      endif\r\n    elsif code >= 51 and code <= 67\r\n      assign condition = condition | append: \"Rain,\"\r\n      if is_day == 1\r\n        assign image_day = image_day | append: \"wi-day-rain.svg,\"\r\n      else\r\n        assign image_day = image_day | append: \"wi-night-rain.svg,\"\r\n      endif\r\n    elsif code >= 71 and code <= 77\r\n      assign condition = condition | append: \"Snow,\"\r\n      if is_day == 1\r\n        assign image_day = image_day | append: \"wi-day-snow.svg,\"\r\n      else\r\n        assign image_day = image_day | append: \"wi-night-snow.svg,\"\r\n      endif\r\n    elsif code >= 80 and code <= 82\r\n      assign condition = condition | append: \"Rain,\"\r\n      if is_day == 1\r\n        assign image_day = image_day | append: \"wi-day-rain.svg,\"\r\n      else\r\n        assign image_day = image_day | append: \"wi-night-rain.svg,\"\r\n      endif\r\n    elsif code >= 85 and code <= 86\r\n      assign condition = condition | append: \"Snow,\"\r\n      if is_day == 1\r\n        assign image_day = image_day | append: \"wi-day-snow.svg,\"\r\n      else\r\n        assign image_day = image_day | append: \"wi-night-snow.svg,\"\r\n      endif\r\n    else\r\n      assign condition = condition | append: \"Storm,\"\r\n      if is_day == 1\r\n        assign image_day = image_day | append: \"wi-day-thunderstorm.svg,\"\r\n      else\r\n        assign image_day = image_day | append: \"wi-night-thunderstorm.svg,\"\r\n      endif\r\n    endif\r\n  endfor\r\n\r\n  assign image_day = image_day | split: \",\"\r\n  assign condition = condition | split: \",\"\r\n%}\n\n<div class=\"{{ extension.css_classes }}\">\n  <div class=\"view view--full\">\n    <div class=\"layout layout--col gap--medium\">\r\n  <div class=\"grid\">\r\n    <div class=\"row row--center col--span-3 col--end\">\r\n      <img class=\"weather-image\" src=\"https://usetrmnl.com/images/plugins/weather/{{ source_1.image_day[0] }}\">\r\n    </div>\r\n    <div class=\"col col--span-3 col--end\">\r\n      <div class=\"item h--full\">\r\n        <div class=\"meta\"></div>\r\n        <div class=\"content\">\r\n          <span class=\"value value--xxxlarge lg:value--mega\" data-fit-value=\"true\">{{ current.temperature_2m | round }}°</span>\r\n          <span class=\"label lg:label--large\">Temperature ({{ current.time | date: \"%l:%M %p\" | lstrip }})</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"col col--span-3 col--end gap--medium\">\r\n      <div class=\"item\">\r\n        <div class=\"meta\"></div>\r\n        <div class=\"icon\">\r\n          <img class=\"weather-icon\" src=\"https://usetrmnl.com/images/plugins/weather/wi-thermometer.svg\">\r\n        </div>\r\n        <div class=\"content\">\r\n          <span class=\"value value--small lg:value--base\">{{ daily.temperature_2m_min[0] | round }}° / {{ daily.temperature_2m_max[0] | round }}°</span>\r\n          <span class=\"label lg:label--large\">Low / High</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"item\">\r\n        <div class=\"meta\"></div>\r\n        <div class=\"icon\">\r\n          <img class=\"weather-icon\" src=\"https://usetrmnl.com/images/plugins/weather/wi-raindrops.svg\">\r\n        </div>\r\n        <div class=\"content\">\r\n          <span class=\"value value--small lg:value--base\">{{ current.relative_humidity_2m }}%</span>\r\n          <span class=\"label lg:label--large\">Humidity</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"item\">\r\n        <div class=\"meta\"></div>\r\n        <div class=\"icon\">\r\n          <img class=\"weather-icon\" src=\"https://usetrmnl.com/images/plugins/weather/wi-hot.svg\">\r\n        </div>\r\n        <div class=\"content\">\r\n          <span class=\"value value--small lg:value--base\">{{ daily.uv_index_max[0] | round }}</span>\r\n          <span class=\"label lg:label--large\">UV Index</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <!-- <div class=\"divider\"></div> -->\r\n  <!-- forecast -->\r\n  <div class=\"grid grid--cols-5 h--full\">\r\n    {% for i in (1..5) %}\r\n    <div class=\"col col--start gap--medium lg:gap--distribute text--center bg--gray-75 rounded--small p--2\">\r\n      {% if forloop.index == 1 %}\r\n      <span class=\"title text-stroke lg:title--large\">Tomorrow</span>\r\n      {% else %}\r\n      <span class=\"title text-stroke lg:title--large\">{{ daily.time[i] | date: \"%A\" }}</span>\r\n      {% endif %}\r\n      <div class=\"w--full\">\r\n        <img class=\"weather-icon-forecast image-stroke\" src=\"https://usetrmnl.com/images/plugins/weather/{{ source_1.image_day[i] }}\">\r\n        <br/>\r\n        <span class=\"description text-stroke visible lg:hidden\">{{ source_1.condition[i] }}</span>\r\n        <span class=\"label label--large text-stroke hidden lg:visible\">{{ source_1.condition[i] }}</span>\r\n      </div>\r\n      <div class=\"w--full\">\r\n        <span class=\"value value--xsmall lg:value--base text-stroke\">{{ daily.temperature_2m_min[i] | round }}° / {{ daily.temperature_2m_max[i] | round }}°</span>\r\n      </div>\r\n      <div class=\"w--full\">\r\n        <div class=\"flex flex--row gap--xsmall\">\r\n          <img class=\"weather-icon-mini image-stroke\" src=\"https://usetrmnl.com/images/plugins/weather/wi-hot.svg\">\r\n          <span class=\"value value--xxsmall lg:value--small text-stroke mr--1\">{{ daily.uv_index_max[i] | round }}</span>\r\n          <img class=\"weather-icon-mini image-stroke\" src=\"https://usetrmnl.com/images/plugins/weather/wi-rain.svg\" />\r\n          <span class=\"value value--xxsmall lg:value--small text-stroke\">{{ daily.precipitation_probability_max[i] }}%</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    {% endfor %}\r\n  </div>\r\n</div>\r\n<div class=\"flex flex--row flex--right description mr--1\">Data courtesy of Open-Meteo.com</div>\r\n<div class=\"title_bar\">\r\n  <img class=\"image\" src=\"https://usetrmnl.com/images/plugins/weather--render.svg\">\r\n  <h1 class=\"title\">Daily Weather</h1>\r\n  <span class=\"instance\">{{ extension.values.location_name }}</span>\r\n</div>\n  </div>\n</div>\n', 'daily_weather', 'Imported from TRMNL.', 'none') RETURNING \"extension\".\"id\", \"extension\".\"name\", \"extension\".\"label\", \"extension\".\"logo_data\", \"extension\".\"description\", \"extension\".\"kind\", \"extension\".\"tags\", \"extension\".\"static_body\", \"extension\".\"fields\", \"extension\".\"template\", \"extension\".\"data\", \"extension\".\"interval\", \"extension\".\"unit\", \"extension\".\"days\", \"extension\".\"last_day_of_month\", \"extension\".\"start_at\", \"extension\".\"created_at\", \"extension\".\"updated_at\", \"extension\".\"mode\"","db":"postgres","duration":2}
