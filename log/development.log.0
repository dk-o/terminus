{"id":"terminus","level":"INFO","at":"2026-05-27T21:56:18+00:00","message":"INSERT INTO \"extension_exchange\" (\"extension_id\", \"headers\", \"verb\", \"template\", \"body\") VALUES (1, 'null'::jsonb, 'get', 'https://api.open-meteo.com/v1/forecast?latitude={{ extension.values.latitude }}&longitude={{ extension.values.longitude }}&daily=weather_code,temperature_2m_max,temperature_2m_min,uv_index_max,precipitation_probability_max,precipitation_probability_min,precipitation_probability_mean&current=temperature_2m,relative_humidity_2m,weather_code,precipitation,is_day&timezone=auto&temperature_unit={{ extension.values.temp_unit }}', 'null'::jsonb) RETURNING \"extension_exchange\".\"id\", \"extension_exchange\".\"extension_id\", \"extension_exchange\".\"headers\", \"extension_exchange\".\"verb\", \"extension_exchange\".\"template\", \"extension_exchange\".\"body\", \"extension_exchange\".\"data\", \"extension_exchange\".\"errors\", \"extension_exchange\".\"refreshed_at\", \"extension_exchange\".\"created_at\", \"extension_exchange\".\"updated_at\"","db":"postgres","duration":3}
